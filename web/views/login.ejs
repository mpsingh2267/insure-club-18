<%- include('partials/header') %>
<div class="login-frame">
  <section class="login-showcase">
    <div class="login-brand"><div class="brand-mark">IC</div><strong>Insure Club 18</strong></div>
    <div class="login-hero">
      <div class="login-hero-label">Advisor operating system</div>
      <h1>Every client. Every policy. One clear view.</h1>
      <p>Manage relationships, renewals, opportunities, meetings, and thoughtful customer communication from a single private workspace.</p>
      <div class="login-proof"><div><strong>360°</strong><span>Customer context</span></div><div><strong>15·7·2</strong><span>Renewal cadence</span></div><div><strong>Always on</strong><span>Service automation</span></div></div>
    </div>
  </section>
  <section class="login-panel">
    <div class="page-eyebrow">Secure access</div>
    <h2>Welcome back</h2>
    <p>Sign in to continue to your advisory workspace.</p>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form method="post" action="/login" class="vstack gap-3">
      <div><label class="form-label">Username</label><input class="form-control" name="username" autocomplete="username" placeholder="Enter your username" required /></div>
      <div><label class="form-label">Password</label><input type="password" class="form-control" name="password" autocomplete="current-password" placeholder="Enter your password" required /></div>
      <button class="btn btn-primary w-100">Sign in to workspace</button>
    </form>
    <div class="login-hint">Local setup access: <strong>admin</strong> / <strong>admin123</strong></div>
  </section>
</div>
<%- include('partials/footer') %>
