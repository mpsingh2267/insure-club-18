  <% if (loggedIn) { %>
        </section>
      </main>
    </div>
  <% } else { %>
    </main>
  <% } %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.js"></script>
  <% if (csrfToken) { %>
  <script>
    (function attachCsrf() {
      const token = '<%= csrfToken %>';
      document.querySelectorAll('form').forEach((form) => {
        const method = (form.getAttribute('method') || 'get').toLowerCase();
        if (method !== 'post') return;
        if (!form.querySelector('input[name="_csrf"]')) {
          const input = document.createElement('input');
          input.type = 'hidden'; input.name = '_csrf'; input.value = token; form.appendChild(input);
        }
        if ((form.enctype || '').toLowerCase() !== 'multipart/form-data') return;
        try {
          const url = new URL(form.getAttribute('action') || window.location.pathname, window.location.origin);
          if (!url.searchParams.get('_csrf')) {
            url.searchParams.set('_csrf', token);
            form.setAttribute('action', `${url.pathname}${url.search}${url.hash}`);
          }
        } catch (error) { /* Ignore invalid form action. */ }
      });
      const menuButton = document.getElementById('menuButton');
      const backdrop = document.getElementById('sidebarBackdrop');
      const closeSidebar = () => document.body.classList.remove('sidebar-open');
      if (menuButton) menuButton.addEventListener('click', () => document.body.classList.toggle('sidebar-open'));
      if (backdrop) backdrop.addEventListener('click', closeSidebar);
      document.querySelectorAll('.sidebar-link').forEach((link) => link.addEventListener('click', closeSidebar));
    })();
  </script>
  <% } %>
</body>
</html>
