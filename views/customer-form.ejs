<%- include('partials/header') %>
<h1 class="h3 mb-3"><%= customer ? 'Edit Customer' : 'Add Customer' %></h1>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<form method="post" action="<%= action %>" class="card p-3 mb-4">
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label">Full name</label><input class="form-control" name="full_name" value="<%= customer?.full_name || '' %>" required /></div>
    <div class="col-md-3"><label class="form-label">Phone</label><input class="form-control" name="phone" value="<%= customer?.phone || '' %>" /></div>
    <div class="col-md-3"><label class="form-label">Email</label><input type="email" class="form-control" name="email" value="<%= customer?.email || '' %>" /></div>
    <div class="col-md-6"><label class="form-label">Address</label><input class="form-control" name="address" value="<%= customer?.address || '' %>" /></div>
    <div class="col-md-3"><label class="form-label">Date of Birth</label><input type="date" class="form-control" name="date_of_birth" value="<%= customer?.date_of_birth || '' %>" /></div>
    <div class="col-md-3"><label class="form-label">Anniversary</label><input type="date" class="form-control" name="anniversary_date" value="<%= customer?.anniversary_date || '' %>" /></div>
    <div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="notes" rows="3"><%= customer?.notes || '' %></textarea></div>
  </div>
  <div class="mt-3 d-flex gap-2">
    <button class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" href="/customers">Back</a>
  </div>
</form>

<% if (customer) { %>
<div class="card p-3">
  <h2 class="h5">Family Members (max 5)</h2>
  <form method="post" action="/customers/<%= customer.id %>/family" class="row g-2 mb-3">
    <div class="col-md-3"><input class="form-control" name="name" placeholder="Name" required /></div>
    <div class="col-md-2"><input class="form-control" name="relationship" placeholder="Relationship" required /></div>
    <div class="col-md-2"><input type="date" class="form-control" name="date_of_birth" /></div>
    <div class="col-md-2"><input type="date" class="form-control" name="anniversary_date" /></div>
    <div class="col-md-2">
      <select class="form-select" name="policy_id">
        <option value="">Link policy (optional)</option>
        <% customerPolicies.forEach((policy) => { %>
          <option value="<%= policy.id %>"><%= policy.policy_number %> - <%= policy.policy_type %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-1"><button class="btn btn-outline-primary w-100">Add</button></div>
  </form>

  <div class="table-responsive">
    <table class="table table-sm align-middle">
      <thead><tr><th>Name</th><th>Relation</th><th>DOB</th><th>Anniversary</th><th>Action</th></tr></thead>
      <tbody>
        <% familyMembers.forEach((member) => { %>
          <tr>
            <td><%= member.name %></td>
            <td><%= member.relationship %></td>
            <td><%= member.date_of_birth || '-' %></td>
            <td><%= member.anniversary_date || '-' %></td>
            <td>
              <form method="post" action="/family-members/<%= member.id %>/delete" onsubmit="return confirm('Delete this family member?')">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (familyMembers.length === 0) { %><tr><td colspan="5" class="text-muted">No family members added.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<% } %>
<%- include('partials/footer') %>
