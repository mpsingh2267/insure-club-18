<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Customers</h1>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary btn-sm" href="/customers/export.csv">Export CSV</a>
    <a class="btn btn-primary btn-sm" href="/customers/new">Add Customer</a>
  </div>
</div>

<form method="get" class="row g-2 mb-3">
  <div class="col-md-7"><input class="form-control" name="q" placeholder="Search by name, phone, email" value="<%= q %>" /></div>
  <div class="col-md-3">
    <select class="form-select" name="sort">
      <option value="full_name" <%= sort === 'full_name' ? 'selected' : '' %>>Sort by name</option>
      <option value="created_at" <%= sort === 'created_at' ? 'selected' : '' %>>Sort by created date</option>
      <option value="date_of_birth" <%= sort === 'date_of_birth' ? 'selected' : '' %>>Sort by DOB</option>
      <option value="anniversary_date" <%= sort === 'anniversary_date' ? 'selected' : '' %>>Sort by anniversary</option>
    </select>
  </div>
  <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div>
</form>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>DOB</th><th>Anniversary</th><th>Policies</th><th>Actions</th></tr></thead>
    <tbody>
      <% customers.forEach((customer) => { %>
        <tr>
          <td><%= customer.full_name %></td>
          <td><%= customer.phone || '-' %></td>
          <td><%= customer.email || '-' %></td>
          <td><%= customer.date_of_birth || '-' %></td>
          <td><%= customer.anniversary_date || '-' %></td>
          <td><%= customer.policy_count %></td>
          <td>
            <div class="d-flex gap-1">
              <a class="btn btn-sm btn-outline-primary" href="/customers/<%= customer.id %>/edit">Edit</a>
              <form method="post" action="/customers/<%= customer.id %>/delete" onsubmit="return confirm('Delete this customer?')">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
              <form method="post" action="/messages/send-occasion/<%= customer.id %>/birthday">
                <button class="btn btn-sm btn-outline-success">Birthday Msg</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (customers.length === 0) { %><tr><td colspan="7" class="text-center text-muted">No customers found.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
