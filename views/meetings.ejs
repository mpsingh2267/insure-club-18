<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Meetings</h1>
  <a class="btn btn-primary btn-sm" href="/meetings/new">Schedule Meeting</a>
</div>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead><tr><th>Title</th><th>With</th><th>Date</th><th>Time</th><th>Status</th><th>Location</th><th>Actions</th></tr></thead>
    <tbody>
      <% meetings.forEach((meeting) => { %>
        <tr>
          <td><%= meeting.title %></td>
          <td><%= meeting.customer_name || meeting.prospect_name || 'Unlinked' %></td>
          <td><%= meeting.meeting_date %></td>
          <td><%= meeting.meeting_time || '-' %></td>
          <td><%= meeting.meeting_status %></td>
          <td><%= meeting.location || '-' %></td>
          <td>
            <div class="d-flex gap-1">
              <a class="btn btn-sm btn-outline-primary" href="/meetings/<%= meeting.id %>/edit">Edit</a>
              <form method="post" action="/meetings/<%= meeting.id %>/delete" onsubmit="return confirm('Delete this meeting?')">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (meetings.length === 0) { %><tr><td colspan="7" class="text-center text-muted">No meetings yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('partials/footer') %>
